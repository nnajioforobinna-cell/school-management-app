{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "School Platform",
  "version": "0.1.0",
  "identifier": "com.sonsschool.schoolplatform",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "School Platform",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "copyright": "© Holy Family Secondary School",
    "shortDescription": "School management: students, attendance, grades, fees.",
    "longDescription": "Manage students, staff, attendance, gradebook, report cards, fees and school accounts — works offline and syncs when back online.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
